# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=hema
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hema
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DSN, собранный из значений выше (для сервера/миграций)
DATABASE_URL=postgres://hema:change-me@localhost:5432/hema?sslmode=disable

# ── Go server ─────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# JWT: замените на длинные случайные строки (например `openssl rand -base64 48`)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ── Bootstrap admin ────────────────────────────────────────────
# Креды для создания первого админа при старте сервера. Заполняйте только
# при первом развёртывании: если админов в БД ещё нет, сервер создаст одного
# с этими кредами. После первого входа ROTIRUЙТЕ пароль админа и уберите
# эти переменные из окружения (бутстрап идемпотентно пропустится).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin

# ── Почта восстановления пароля (спека 0037) ───────────────────
# Базовый адрес публичного веб-приложения — используется для сборки ссылки
# восстановления в письме.
PUBLIC_APP_URL=http://localhost:3000
# Срок жизни ссылки восстановления пароля.
PASSWORD_RESET_TTL=30m
# SMTP-креды доставки писем. Все поля опциональны: пустой SMTP_HOST —
# легальная конфигурация (NFR-3), сервер тогда пишет письма в журнал вместо
# реальной отправки — так работают dev и тесты без почтового сервера.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@hema-tournament.example

# ── Учётка, почта и файлы (спека 0042) ──────────────────────────
# Срок жизни ссылки подтверждения/смены email.
EMAIL_TOKEN_TTL=24h
# Каталог локального тома файлового хранилища (регламент и эмблема
# турнира, ADR 0019). Пусто — легальная конфигурация (NFR-4): хранилище
# выключено, загрузка файлов недоступна, регламент/эмблема остаются
# доступны по внешней ссылке.
FILE_STORAGE_DIR=
# Пороги размера загружаемого файла на каждый вид, в байтах.
REGULATIONS_MAX_BYTES=10485760
EMBLEM_MAX_BYTES=5242880
# Ограничение частоты запросов по адресу источника (вход, регистрация,
# восстановление/смена пароля, подтверждение email) — не более
# RATE_LIMIT_REQUESTS запросов на адрес за окно RATE_LIMIT_WINDOW.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=1m
# Доверять ли заголовку X-Forwarded-For при определении адреса клиента.
# По умолчанию false: без доверенного прокси перед сервером клиент мог бы
# подделать заголовок и обойти ограничение (NFR-6). В docker-compose BFF —
# единственный сетевой клиент сервера (ADR 0001), поэтому там можно
# включить.
RATE_LIMIT_TRUST_PROXY=false

# ── Web / BFF ─────────────────────────────────────────────────
# Адрес Go-сервера, куда BFF ходит по gRPC/Connect
SERVER_GRPC_URL=http://localhost:8080
# Порт Next.js
WEB_PORT=3000

# ── Preprod access gate (спека 0046) ───────────────────────────
# Гейт публичных страниц и данных для анонимов. Значение `true` — включено;
# пусто или любое другое значение — выключено, сайт работает как обычно.
PREPROD_MODE=
# Пауза самостоятельной регистрации: новые пользователи не могут создать
# аккаунт сами. Независима от PREPROD_MODE (можно поставить на паузу даже при
# выключенном гейте). То же правило: пусто или любое другое значение —
# выключено, регистрация работает как обычно.
REGISTRATION_DISABLED=

# ── HTTPS-шлюз для публичного запуска (спека 0048, make deploy) ──
# Домен, на который указывает DNS этого сервера. Обязателен для
# `make deploy` — без него сервис proxy не сможет получить сертификат.
PUBLIC_DOMAIN=
# Контактный email для уведомлений удостоверяющего центра (Let's Encrypt)
# об истечении сертификата. Опционален — пусто заменяется на
# admin@<PUBLIC_DOMAIN> (docker-compose.yml).
ACME_EMAIL=
